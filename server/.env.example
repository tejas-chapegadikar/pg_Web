# Copy to server/.env and fill in. Blank optional values just switch that feature off.

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database — `npm run db` starts a local one at this address; use a MongoDB Atlas URI when deploying
MONGO_URI=mongodb://127.0.0.1:27017/aneighar

# Long random strings (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Email — sign-up codes, password resets, request notifications.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<16-letter app password>,
#        EMAIL_FROM=Anei Ghar <you@gmail.com>   (Gmail sends at most ~500 emails a day)
# Left blank, emails are printed in this server's console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Anei Ghar <no-reply@aneighar.com>

# Local development only: while SMTP is blank, also show the sign-up code on screen.
# Ignored when NODE_ENV=production or once SMTP is set.
OTP_DEV_ECHO=false

# Firebase — Google sign-in (and POST /api/auth/phone, which the website no longer uses).
# The project ID is enough to verify sign-ins;
# a service account (client email + private key with \n for newlines) is optional.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudinary — listing photos. Left blank in development, photos are saved in server/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
