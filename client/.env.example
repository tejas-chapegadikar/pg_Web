# Copy to client/.env. Everything here is optional; features without keys show a "not set up" message.

# Firebase web app config (Firebase console → Project settings → Your apps).
# Needed for "Continue with Google". Turn on Google under Authentication → Sign-in method,
# and keep localhost in Authentication → Settings → Authorized domains.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Google Maps (map view on the listings page, map pin picker when adding a listing)
VITE_GOOGLE_MAPS_API_KEY=

# Where the dev server sends /api requests
# VITE_BACKEND=http://localhost:5000
